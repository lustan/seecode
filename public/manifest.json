{
  "name": "__MSG_extensionName__",
  "version": "4.0.6",
  "manifest_version": 3,
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": ["storage", "contextMenus"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DiffPad"
  },
  "commands": {
    "open-full-editor": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Open DiffPad full editor"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
